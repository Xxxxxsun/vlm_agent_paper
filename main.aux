\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Exp\nobreakspace  {}I: Distribution-shift adaptation in a non-stationary stream.} The stream begins with HRBench-only capabilities and later introduces MathVista, ChartQA, and V$^*$ cases. \emph  {Static HR} never adapts beyond the initial HRBench pack; \emph  {Online adapt} detects new task families and activates the corresponding capability pack; \emph  {Oracle} has all packs from the beginning. Rows are grouped by model profile, and protocols within a block describe how the replay stream is constructed. Standard deviations are temporary layout placeholders and must be replaced with seed-based estimates before submission. \relax }}{9}{table.caption.20}\protected@file@percent }
\newlabel{tab:distribution_shift}{{2}{9}{\textbf {Exp~I: Distribution-shift adaptation in a non-stationary stream.} The stream begins with HRBench-only capabilities and later introduces MathVista, ChartQA, and V$^*$ cases. \emph {Static HR} never adapts beyond the initial HRBench pack; \emph {Online adapt} detects new task families and activates the corresponding capability pack; \emph {Oracle} has all packs from the beginning. Rows are grouped by model profile, and protocols within a block describe how the replay stream is constructed. Standard deviations are temporary layout placeholders and must be replaced with seed-based estimates before submission. \relax }{table.caption.20}{}}
