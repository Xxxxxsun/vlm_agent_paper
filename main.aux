\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Exp\nobreakspace  {}II: Learning to use pre-provided tools on GTA.} We report three of GTA's step-by-step metrics (\textbf  {InstAcc}: Instruction-Following; \textbf  {ToolAcc}: Tool Selection; \textbf  {ArgAcc}: Argument Prediction) and the end-to-end \textbf  {AnsAcc} (Answer Accuracy). GTA's \textbf  {SummAcc} requires per-step summary scoring and is not reported. \emph  {Skill Evolution (Ours)} applies \textsc  {Dynamo}{} Mode\nobreakspace  {}B, which learns per-tool mastery SOPs from the training set without generating new tools. \relax }}{8}{table.caption.23}\protected@file@percent }
\newlabel{tab:gta_detailed}{{3}{8}{\textbf {Exp~II: Learning to use pre-provided tools on GTA.} We report three of GTA's step-by-step metrics (\textbf {InstAcc}: Instruction-Following; \textbf {ToolAcc}: Tool Selection; \textbf {ArgAcc}: Argument Prediction) and the end-to-end \textbf {AnsAcc} (Answer Accuracy). GTA's \textbf {SummAcc} requires per-step summary scoring and is not reported. \emph {Skill Evolution (Ours)} applies \sysname {} Mode~B, which learns per-tool mastery SOPs from the training set without generating new tools. \relax }{table.caption.23}{}}
