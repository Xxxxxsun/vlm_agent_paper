\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {Diagnosis-polarity stress test on ChartQA.} Correct-only evidence cannot drive evolution because no missed cases are available. Error-only evidence repeatedly triggers new tool generation (\texttt  {chart\_data\_point\_highlighter}, \texttt  {chart\_series\_value\_overlay}, and \texttt  {chart\_data\_point\_overlay\_generator}) but promotes none of them. The selection baseline and candidates for the two completed error-only rounds are both 46/50, so the generated tools do not improve the subset despite repeated regeneration. \relax }}{17}{table.caption.12}\protected@file@percent }
\newlabel{tab:ablation_diagnosis_polarity}{{8}{17}{\textbf {Diagnosis-polarity stress test on ChartQA.} Correct-only evidence cannot drive evolution because no missed cases are available. Error-only evidence repeatedly triggers new tool generation (\texttt {chart\_data\_point\_highlighter}, \texttt {chart\_series\_value\_overlay}, and \texttt {chart\_data\_point\_overlay\_generator}) but promotes none of them. The selection baseline and candidates for the two completed error-only rounds are both 46/50, so the generated tools do not improve the subset despite repeated regeneration. \relax }{table.caption.12}{}}
