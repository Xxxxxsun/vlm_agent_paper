\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Mechanism ablations.} Each row removes one mechanism from \textsc  {Dynamo}{} while holding all others fixed (GPT-5.4 backbone; $k{=}200$, $N{=}3$). The ablated dimensions are \emph  {mechanisms} (how capabilities are generated, diagnosed, gated, and reused) rather than capability \emph  {types}, which are already ablated by the \emph  {Skill Only} / \emph  {Tool Only} rows of Table\nobreakspace  {}\ref  {tab:evolution_full}. The Full row reproduces the Skill\nobreakspace  {}$+$\nobreakspace  {}Tool entry of Table\nobreakspace  {}\ref  {tab:evolution_full}, and the Direct row reproduces the None (Base Agent) entry, both for reference. The four ablation rows are \emph  {layout placeholders} chosen to illustrate the expected qualitative pattern and must be replaced with measured values before submission. \relax }}{11}{table.caption.44}\protected@file@percent }
\newlabel{tab:ablation_mechanism}{{7}{11}{\textbf {Mechanism ablations.} Each row removes one mechanism from \sysname {} while holding all others fixed (GPT-5.4 backbone; $k{=}200$, $N{=}3$). The ablated dimensions are \emph {mechanisms} (how capabilities are generated, diagnosed, gated, and reused) rather than capability \emph {types}, which are already ablated by the \emph {Skill Only} / \emph {Tool Only} rows of Table~\ref {tab:evolution_full}. The Full row reproduces the Skill~$+$~Tool entry of Table~\ref {tab:evolution_full}, and the Direct row reproduces the None (Base Agent) entry, both for reference. The four ablation rows are \emph {layout placeholders} chosen to illustrate the expected qualitative pattern and must be replaced with measured values before submission. \relax }{table.caption.44}{}}
